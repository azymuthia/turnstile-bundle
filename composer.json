{
    "name": "azymuthia/turnstile-bundle",
    "description": "Strict Cloudflare Turnstile verification for Symfony firewalls and forms, refusing whenever it cannot verify.",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "bundle",
        "cloudflare",
        "turnstile",
        "captcha",
        "security",
        "login"
    ],
    "authors": [
        {
            "name": "Bartosz Piotr Pazoła"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-client-contracts": "^3.4",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/options-resolver": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/security-http": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/uid": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0",
        "twig/twig": "^3.12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.88",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0",
        "symfony/rate-limiter": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Azymuthia\\TurnstileBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Azymuthia\\TurnstileBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "code-quality": "php-cs-fixer check --diff",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "tests": "phpunit"
    }
}
