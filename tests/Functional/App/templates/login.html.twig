{% if error %}
    <div class="error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% if error.errorCodes is defined %}<div class="error-codes">{{ error.errorCodes|join(',') }}</div>{% endif %}
{% endif %}
<form method="post" action="{{ path('login') }}">
    <input name="_username" value="{{ last_username }}">
    <input name="_password" type="password">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    {{ azymuthia_turnstile_widget('login') }}
    <button type="submit">Log in</button>
</form>
